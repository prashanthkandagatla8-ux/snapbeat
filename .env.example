# Port to listen on (automatically assigned on Render, Railway, Heroku)
PORT=8000

# Comma-separated list of active SnapBeat rendering servers
# Example: http://your-vps-ip:8772,http://another-server:8772
SNAPBEAT_BACKENDS=http://localhost:8772

# Optional serverless fallback URL if all primary backends are saturated
# SNAPBEAT_SERVERLESS_URL=https://snapbeat-cloudrun-xyz.run.app
