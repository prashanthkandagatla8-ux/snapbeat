# ==============================================================================
# SNAPBEAT STUDIO — HYBRID AD MONETIZATION CONFIGURATION
# ==============================================================================

# Network 1: Google AdSense / Google Ad Manager
# Your 16-digit AdSense Publisher ID (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google AdSense Display Slot ID (for hardware telemetry plaque)
NEXT_PUBLIC_ADSENSE_BANNER_SLOT_ID=

# Network 2: Monetag (PropellerAds)
# Your Monetag Zone Script URL (e.g., //thubanoa.com/1?z=1234567)
NEXT_PUBLIC_MONETAG_SCRIPT_URL=

# Monetag Zone ID for Rewarded Interstitial Video
NEXT_PUBLIC_MONETAG_ZONE_ID=

# Ad Monetization Mode: 'hybrid' (Google -> Monetag -> Fallback)
NEXT_PUBLIC_AD_MODE=hybrid
