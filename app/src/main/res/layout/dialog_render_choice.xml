<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRenderChoice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#191816"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvRenderChoiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬 CHOOSE RENDER MODE"
            android:textColor="#FFE14D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRenderChoiceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select how you would like your video rendered:"
            android:textColor="#A8A398"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Option 1: Instant Render (No Watermark) -->
        <LinearLayout
            android:id="@+id/cardOptionInstant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvInstantTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ INSTANT RENDER"
                    android:textColor="#FFE14D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvInstantBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NO WATERMARK"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/badge_pill_yellow"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInstantDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Cloud Run serverless (zero waiting time)\n• Full Master 1080p bitrate\n• Clean video with NO watermark\n• Cost: 1 Credit (or Pro Pass)"
                android:textColor="#FFFCF5"
                android:alpha="0.85"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseInstant"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_retro_yellow"
                android:text="⚡ RENDER INSTANT (1 CREDIT)"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Option 2: Free Queue (With Watermark) -->
        <LinearLayout
            android:id="@+id/cardOptionQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvQueueOptionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📥 FREE QUEUE"
                    android:textColor="#3DD4FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% FREE"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/badge_pill_cyan"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQueueDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Unlimited renders on VPS engine\n• Runs in background — safe to close app\n• Push notification when video is ready\n• Includes subtle SnapBeat watermark"
                android:textColor="#FFFCF5"
                android:alpha="0.85"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseQueue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_retro_blue"
                android:text="📥 RENDER FREE WITH WATERMARK"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Option 3: Remove Watermark Directly -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRemoveWatermark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_retro_pink"
            android:text="👑 REMOVE WATERMARK (PRO PASS / CREDITS)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <!-- Cancel / Close -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelChoice"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@null"
            android:text="CANCEL"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
