<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ═══════════════ HEADER ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SNAPBEAT"
                android:textColor="#FFE14D"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="0" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- Mode Switch (AUTO / PRO) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvModeAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUTO"
                        android:textStyle="bold"
                        android:textColor="#FFE14D"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#FFE14D"
                        app:trackTint="#333333" />

                    <TextView
                        android:id="@+id/tvModePro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:textStyle="bold"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Theme Selector Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnThemeSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🎨 THEME: DARK ▾"
                    android:textColor="#FFE14D"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/badge_circle"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="let the music decide your edit."
            android:textColor="#FFFCF5"
            android:textSize="14sp"
            android:fontFamily="casual"
            android:alpha="0.7"
            android:layout_marginBottom="20dp" />

        <!-- ═══════════════ PRO MODE TEMPLATE ═══════════════ -->
        <LinearLayout
            android:id="@+id/proModeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/card_dark"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvProTemplateHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ PRO TEMPLATE"
                android:textStyle="bold"
                android:textColor="#FFE14D"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerTemplate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_retro"
                android:popupBackground="#2A2A2A" />

            <View
                android:id="@+id/divPro1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💥 DROP IT"
                        android:textStyle="bold"
                        android:textColor="#FF4D8D"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvDropItDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="burst montage on bass drops"
                        android:textColor="#FFFCF5"
                        android:alpha="0.5"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDropIt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#FF4D8D"
                    app:trackTint="#333333" />
            </LinearLayout>

            <View
                android:id="@+id/divPro2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvAspectRatioHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📐 ASPECT RATIO"
                android:textStyle="bold"
                android:textColor="#3DD4FF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerAspectRatio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_retro"
                android:popupBackground="#2A2A2A" />

            <View
                android:id="@+id/divProQuality"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvQualityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ VIDEO QUALITY"
                android:textStyle="bold"
                android:textColor="#3DD4FF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgVideoQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbQualityFast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Optimized (Fast Download ~5 MB)"
                    android:textColor="#FFFCF5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:buttonTint="#3DD4FF"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbQualityMaster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Master Quality (Full Bitrate ~20 MB)"
                    android:textColor="#FFFCF5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:buttonTint="#3DD4FF" />
            </RadioGroup>

            <View
                android:id="@+id/divProArrangement"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvArrangementHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ PHOTO ARRANGEMENT"
                android:textStyle="bold"
                android:textColor="#FFE14D"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgArrangement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbArrangeAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI Smart Arrange (Gemini Beat-Sync)"
                    android:textColor="#FFFCF5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:buttonTint="#FFE14D"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbArrangeManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✋ Manual (Drag &amp; Drop Custom Order)"
                    android:textColor="#FFFCF5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:buttonTint="#FFE14D" />
            </RadioGroup>

            <View
                android:id="@+id/divPro3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvTitleCardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 TITLE CARD DESIGNER"
                android:textStyle="bold"
                android:textColor="#FFE14D"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etTitleText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter title text (optional)"
                android:textColor="#FFFCF5"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:background="@drawable/spinner_retro"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:maxLength="50"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <!-- Font Selector -->
            <TextView
                android:id="@+id/tvTitleFontLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Typography"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerTitleFont"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_retro"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Visual Style Selector -->
            <TextView
                android:id="@+id/tvTitleStyleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visual Style"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerTitleStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_retro"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Decorative Frame Selector -->
            <TextView
                android:id="@+id/tvTitleFrameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decorative Frame"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerTitleFrame"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_retro"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/tvTitleBgLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rgTitleBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBgBlack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Black"
                    android:textColor="#FFFCF5"
                    android:textSize="11sp"
                    android:buttonTint="#FFE14D"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbBgColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Color"
                    android:textColor="#FFFCF5"
                    android:textSize="11sp"
                    android:buttonTint="#FFE14D" />

                <RadioButton
                    android:id="@+id/rbBgVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Over Video"
                    android:textColor="#FFFCF5"
                    android:textSize="11sp"
                    android:buttonTint="#FFE14D" />

            </RadioGroup>

            <EditText
                android:id="@+id/etTitleBgColor"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Hex color e.g. #FF4D8D"
                android:textColor="#FFFCF5"
                android:textColorHint="#666666"
                android:textSize="12sp"
                android:background="@drawable/spinner_retro"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:maxLength="7"
                android:inputType="text"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvTitleDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekTitleDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="1"
                    android:max="5"
                    android:progress="2"
                    android:progressTint="#FFE14D"
                    android:thumbTint="#FFE14D" />

                <TextView
                    android:id="@+id/tvTitleDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2s"
                    android:textColor="#FFE14D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Live Title Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW"
                android:textColor="#FFE14D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/cardTitlePreview"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="#000000"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvLiveTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="TITLE CARD PREVIEW"
                    android:textColor="#FFE14D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />
            </FrameLayout>
        </LinearLayout>

        <!-- ═══════════════ MUSIC SECTION ═══════════════ -->
        <LinearLayout
            android:id="@+id/cardMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvMusicHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵 MUSIC"
                android:textStyle="bold"
                android:textColor="#FF4D8D"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectMusic"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/btn_retro_pink"
                android:text="PICK A TAPE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSampleMusic"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/btn_retro_yellow"
                android:text="✨ USE SAMPLE TAPE (Funk Party)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="8dp"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tvMusicStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="no tape selected"
                android:layout_marginTop="8dp"
                android:textColor="#FFFCF5"
                android:alpha="0.6"
                android:fontFamily="casual"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/audioTrimContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <View
                    android:id="@+id/divTrim1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2E2E2E"
                    android:layout_marginBottom="8dp" />

                <!-- RadioGroup: Full Track vs Custom Trim -->
                <RadioGroup
                    android:id="@+id/rgAudioLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbAudioFull"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Full Track"
                        android:textColor="#FFFCF5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:buttonTint="#FF4D8D"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbAudioTrim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trim Section"
                        android:textColor="#FFFCF5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:buttonTint="#FF4D8D" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/layoutTrimSliders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Duration Range Summary -->
                    <TextView
                        android:id="@+id/tvAudioRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start: 0:00  |  End: 0:00  (Duration: 0:00)"
                        android:textColor="#FF4D8D"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp" />

                    <!-- Start Slider -->
                    <TextView
                        android:id="@+id/tvAudioStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Time: 0:00"
                        android:textColor="#FFFCF5"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp" />

                    <SeekBar
                        android:id="@+id/seekAudioStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#FF4D8D"
                        android:thumbTint="#FF4D8D" />

                    <!-- End Slider -->
                    <TextView
                        android:id="@+id/tvAudioEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End Time: 0:00"
                        android:textColor="#FFFCF5"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="2dp" />

                    <SeekBar
                        android:id="@+id/seekAudioEnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#FFE14D"
                        android:thumbTint="#FFE14D" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════ PHOTOS SECTION ═══════════════ -->
        <LinearLayout
            android:id="@+id/cardPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvPhotosHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 PHOTOS"
                android:textStyle="bold"
                android:textColor="#3DD4FF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectPhotos"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/btn_retro_blue"
                android:text="POLAROID STACK"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tvPhotosStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 photos (tap to load)"
                android:layout_marginTop="8dp"
                android:textColor="#FFFCF5"
                android:alpha="0.6"
                android:fontFamily="casual"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- AI Auto Arrange Indicator Badge -->
            <LinearLayout
                android:id="@+id/layoutAutoArrangeBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_circle"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="8dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvAutoArrangeIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvAutoArrangeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI SMART ARRANGE (GEMINI BEAT-SYNC)"
                    android:textColor="#FFE14D"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPhotoOrder"
                android:layout_width="match_parent"
                android:layout_height="106dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:visibility="gone"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- ═══════════════ RENDER SECTION ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/progress_retro"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:fontFamily="casual"
                android:textStyle="bold"
                android:textColor="#FFFCF5"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRender"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/btn_retro_yellow"
                android:text="⚡  INSTANT RENDER"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQueue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_retro_blue"
                android:text="📥  ADD TO QUEUE (BACKGROUND)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/cardQueueTray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_dark"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvQueueTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📥 BACKGROUND QUEUE"
                        android:textStyle="bold"
                        android:textColor="#3DD4FF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvQueueBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUEUED"
                        android:textStyle="bold"
                        android:textColor="#FFE14D"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/queueProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_retro"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvQueueStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processing in background • Safe to close app"
                    android:textColor="#FFFCF5"
                    android:alpha="0.85"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewQueueVideo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_retro_pink"
                    android:text="🎬 VIEW RENDERED VIDEO"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="\uD83D\uDD04  RETRY"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_retro_yellow"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- ═══════════════ PRIVACY & LEGAL FOOTER ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvPrivacyPolicyLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Privacy Policy &amp; Terms • Ephemeral Processing"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SnapBeat v1.0 • Beat-Synced Music Video Creator"
                android:textColor="#555555"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
