<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_dark"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Title, Fav Star, Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvJobFavStar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☆"
            android:textSize="20sp"
            android:textColor="#FFE14D"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SnapBeat Video"
            android:textColor="#FFFCF5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvJobStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:textColor="#000000"
            android:background="@drawable/badge_pill_cyan"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Metadata Details Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvJobDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Template: Beat Cut • 9:16 • Fast"
            android:textColor="#A8A398"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvJobDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#777777"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Buttons Row: Play, Download, Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Play Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJobPlay"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/btn_retro_pink"
            android:text="▶ PLAY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- Download Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJobDownload"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/btn_retro_yellow"
            android:text="📥 DOWNLOAD"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- Delete Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJobDelete"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_retro_blue"
            android:text="🗑"
            android:textColor="#000000"
            android:textSize="14sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
